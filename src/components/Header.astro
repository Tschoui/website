---
import profile from '../data/profile.yaml';

const sections = [
  ['about', 'About'],
  ['publications', 'Publications'],
  ['talks', 'Talks & awards'],
  ['community', 'Community'],
  ['organisers', 'Bio & photo'],
  ['contact', 'Contact'],
];
---

<header class="site-header">
  <a class="brand" href="/">{profile.short_name}</a>
  <nav class="site-nav" aria-label="Sections">
    {sections.map(([id, label]) => <a href={`/#${id}`}>{label}</a>)}
  </nav>
</header>
