---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import profile from '../data/profile.yaml';

const address = [
  'Department of Engineering, University of Cambridge',
  'Trumpington Street',
  'Cambridge CB2 1PZ',
  'United Kingdom',
];
---

<Base title={`Impressum & privacy · ${profile.name}`} description={`Legal notice and privacy policy for ${profile.name}'s website.`}>
  <Header />

  <main class="prose">
    <h1>Impressum &amp; privacy</h1>

    <h2>Legal notice (Impressum)</h2>
    <p>Information according to § 5 DDG</p>
    <address>
      {profile.name}<br />
      {address.map((line) => <>{line}<br /></>)}
      Email: <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </address>
    <p>Responsible for the content according to § 18 (2) MStV: {profile.name}, address as above.</p>

    <h2>Privacy policy (Datenschutzerklärung)</h2>

    <h3>Controller</h3>
    <p>{profile.name}, contact details as above.</p>

    <h3>Hosting</h3>
    <p>
      This website is hosted on GitHub Pages, a service of GitHub, Inc., 88 Colin P. Kelly Jr.
      Street, San Francisco, CA 94107, USA. When you open a page, GitHub processes your IP address
      and technical details of the request, such as the date and time, the page requested and your
      browser, in order to deliver the website and protect it against attacks. This is a legitimate
      interest under Art. 6 (1) (f) GDPR. The data may be processed in the USA. GitHub is certified
      under the EU-U.S. Data Privacy Framework, for which the European Commission has issued an
      adequacy decision (Art. 45 GDPR). Details are in
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub's privacy statement</a>.
    </p>

    <h3>No cookies, tracking or third-party content</h3>
    <p>
      This website sets no cookies, uses no analytics or tracking, and loads nothing from other
      services. Fonts and images are delivered together with the website. Links to other websites,
      such as Google Scholar or LinkedIn, only contact those services when you click them.
    </p>

    <h3>Email</h3>
    <p>If you email me, I use your address and message only to reply to you.</p>

    <h3>Your rights</h3>
    <p>
      You have the right to access, correct or delete your personal data, to restrict or object
      to its processing, and to data portability (Art. 15 to 21 GDPR). You can also lodge a
      complaint with a data protection supervisory authority.
    </p>

    <p><a href="/">← Back to the homepage</a></p>
  </main>
</Base>
